# Copy to .env and fill in before `docker compose up -d`.

# The hostname pointing at this server. Caddy gets a certificate for it, and
# both phones connect here.
VEIL_DOMAIN=veil.example.com

# TURN credentials. Any long random strings; both phones use the same pair.
# These do not protect message or call contents - those are already end-to-end
# encrypted - they only stop strangers using your server to relay their own
# traffic.
TURN_USER=veil
TURN_PASSWORD=replace-with-a-long-random-string
