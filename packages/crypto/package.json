{
  "name": "@veil/crypto",
  "version": "0.1.0",
  "description": "Veil cryptographic core: PQXDH handshake, Double Ratchet, sealed sender, SFrame media encryption, at-rest vault",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.1",
    "@types/node": "^22.0.0"
  }
}
