{
  "name": "@veil/relay",
  "version": "0.1.0",
  "description": "Veil relay: a store-and-forward server that cannot read what it carries",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@veil/crypto": "0.1.0",
    "@veil/protocol": "0.1.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
