{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "description": "Veil - end-to-end encrypted private messaging and voice for mobile",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
